---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { profile } from '../data/profile';

// Drop a square photo at src/assets/headshot.(jpg|jpeg|png|webp) and it replaces the monogram.
const found = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/headshot.{jpg,jpeg,png,webp}', { eager: true }),
)[0]?.default;
const initials = profile.name.split(' ').map((p) => p[0]).join('');
---
{found ? (
  <Image src={found} alt={profile.name} width={144} height={144} class="size-12 rounded-full object-cover lg:size-[4.5rem]" loading="eager" />
) : (
  <span aria-hidden="true" class="inline-flex size-12 items-center justify-center rounded-full bg-accent font-serif text-xl text-paper">{initials}</span>
)}
