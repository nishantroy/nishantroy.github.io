---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectMedia from './ProjectMedia.astro';

interface Props { project: CollectionEntry<'projects'> }
const { data: p } = Astro.props.project;
const live = p.status.toLowerCase().startsWith('live');
---
<article class="group">
  <div class="tile relative aspect-[4/3] overflow-hidden rounded-2xl" style={p.tint ? `--tile:${p.tint}` : undefined}>
    <ProjectMedia src={p.screenshot} alt={p.screenshotAlt} frame={p.frame} />
  </div>
  <h3 class="mt-6 flex items-center gap-3 font-serif text-2xl font-medium tracking-tight">
    {p.icon && <Image src={p.icon} alt="" width={64} height={64} class="size-8 shrink-0 rounded-[22%] ring-1 ring-black/10" />}
    {p.name}
  </h3>
  <div class="mt-1.5 flex flex-wrap items-center gap-2">
    <span class:list={[
      'rounded-full px-2 py-0.5 font-mono text-[0.6875rem]',
      live ? 'bg-accent-soft text-accent' : 'border border-rule text-faint',
    ]}>{p.status}</span>
    <span class="font-mono text-[0.6875rem] text-faint">{p.platform}</span>
  </div>
  <p class="mt-2 text-pretty text-lg text-ink">{p.tagline}</p>
  <p class="mt-1 max-w-md text-pretty text-[0.9375rem] leading-relaxed text-soft">{p.hook}</p>
  <p class="mt-3 font-mono text-[0.6875rem] leading-relaxed text-faint">{p.stack.join(" · ")}</p>
  {p.repo && (
    <p class="mt-3 text-sm font-medium">
      <a class="link-underline" href={p.repo}>Source<span class="sr-only"> code for {p.name}</span></a>
    </p>
  )}
</article>
