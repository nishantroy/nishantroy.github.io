---
---
<button
  type="button"
  data-theme-toggle
  class="inline-flex size-9 items-center justify-center text-faint transition-colors hover:text-ink"
  aria-label="Switch color theme"
  title="Switch color theme"
>
  <svg class="theme-sun size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="theme-moon size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
</button>

<style>
  /* Show the icon for the theme you would switch to. */
  .theme-sun { display: none; }
  :global([data-resolved-theme="dark"]) .theme-sun { display: block; }
  :global([data-resolved-theme="dark"]) .theme-moon { display: none; }
</style>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const resolved = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');
  const sync = () => {
    root.dataset.resolvedTheme = resolved();
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) =>
      b.setAttribute('aria-label', `Switch to ${resolved() === 'dark' ? 'light' : 'dark'} theme`),
    );
  };
  sync();
  media.addEventListener('change', sync);
  document.querySelectorAll('[data-theme-toggle]').forEach((button) =>
    button.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      sync();
    }),
  );
</script>
