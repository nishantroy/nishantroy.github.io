---
interface Props { id: string; title: string; aside?: string }
const { id, title, aside } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-8 pt-24 sm:pt-32">
  <div class="mb-10 sm:mb-12">
    <h2 id={`${id}-title`} class="font-serif text-3xl font-medium tracking-tight sm:text-4xl">{title}</h2>
    {aside && <p class="mt-2 font-mono text-xs text-faint">{aside}</p>}
  </div>
  <slot />
</section>
