---
import { profile } from '../data/profile';
import ThemeToggle from './ThemeToggle.astro';
import SectionNav from './SectionNav.astro';
---
<header class="pt-6">
  <div class="flex items-center justify-between gap-4">
    <a href="/" class="font-serif text-xl font-medium tracking-tight">{profile.name}</a>
    <div class="flex items-center gap-2 text-sm sm:gap-3">
      <a class="rounded-full bg-ink px-3.5 py-1.5 font-medium text-paper transition-colors hover:bg-accent" href="/#contact">Contact</a>
      <ThemeToggle />
    </div>
  </div>
  <div class="mt-5 lg:hidden"><SectionNav variant="bar" /></div>
</header>
