---
import { profile } from '../data/profile';
const links = [{ label: 'Email', href: `mailto:${profile.email}` }, ...profile.links.filter((l) => l.label === 'LinkedIn'), ...profile.links.filter((l) => l.label !== 'LinkedIn')];
---
<footer id="contact" class="mt-20 pb-16 sm:mt-28">
  <h2 class="max-w-3xl font-serif text-3xl font-medium leading-tight tracking-tight sm:text-5xl">{profile.contactPrompt}</h2>
  <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-serif text-2xl sm:text-3xl">
    {links.map((l, i) => (
      <li><a class:list={['link-underline transition-colors hover:text-accent', i === 0 ? 'text-accent' : 'text-ink']} href={l.href}>{l.label}<span aria-hidden="true" class="text-faint"> ↗</span></a></li>
    ))}
  </ul>
</footer>
