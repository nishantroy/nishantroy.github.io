---
import { profile } from '../data/profile';
---
<footer id="contact" class="mt-20 pb-12 sm:mt-28">
  <p class="max-w-3xl font-serif text-3xl font-medium leading-tight tracking-tight sm:text-5xl">{profile.contactPrompt}</p>
  <p class="mt-4 max-w-2xl text-lg text-soft">{profile.angel}</p>
  <p class="mt-6">
    <a class="link-underline font-serif text-2xl text-accent sm:text-3xl" href={`mailto:${profile.email}`}>{profile.email}</a>
  </p>
  <div class="mt-16 flex flex-wrap justify-between gap-4 font-mono text-xs text-faint">
    <p>{profile.name} · {profile.location}</p>
    <ul class="flex gap-4">{profile.links.map((l) => <li><a class="hover:text-ink" href={l.href}>{l.label}</a></li>)}</ul>
  </div>
</footer>
