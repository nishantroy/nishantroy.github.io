---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WritingList from '../components/WritingList.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { byDateDesc, yearOf } from '../lib/format';

const items = (await getCollection('writing')).sort(byDateDesc);
const groups = Map.groupBy(items, (w) => yearOf(w.data.date));
---
<Base title="Writing & talks" description={`Articles, talks and podcasts by ${profile.name}.`}>
  <div class="mx-auto max-w-3xl px-5 sm:px-10">
    <Header />
    <main id="content">
      <h1 class="mt-10 font-serif text-5xl font-medium tracking-tight">Writing & talks</h1>
      {[...groups].map(([year, list]) => (
        <section class="mt-14" aria-labelledby={`y-${year}`}>
          <h2 id={`y-${year}`} class="mb-4 border-b border-rule pb-2 font-serif text-2xl">{year}</h2>
          <WritingList items={list} showYear={false} />
        </section>
      ))}
      <Footer />
    </main>
  </div>
</Base>
